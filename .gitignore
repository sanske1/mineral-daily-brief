# 密钥：绝不入库
.env
.env.docker
.env.*
!.env.example

# 运行时产物（data/brief.sqlite3 例外：预置新闻库，随仓库分发）
# 写 data/* 而不是 data/ —— 目录本身被忽略的话，下面的 ! 放行不会生效
.venv/
data/*
!data/brief.sqlite3
out/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 本机绝对路径，换机器要重新生成
mcp-config.json

# 临时
*.log

# IDE / 本机调试配置（含绝对路径，换机器没意义）
.idea/
.claude/
.vscode/
