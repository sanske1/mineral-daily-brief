# 复制成 .env 后填入真实值：cp .env.example .env
#
# Agent 的文本生成走 OpenAI 兼容协议，换供应商只需改这三个变量，代码零改动。
# 默认 DeepSeek（国内直连、无需代理）。

OPENAI_API_KEY=sk-在这里填你的密钥
OPENAI_BASE_URL=https://api.deepseek.com
MDB_MODEL=deepseek-chat

# 可选：数据目录（SQLite 库 + HTTP 磁盘缓存）。默认 ./data
# MDB_DATA_DIR=./data

# 可选：调试用，打印每次 MCP 工具调用
# MDB_TRACE=1
